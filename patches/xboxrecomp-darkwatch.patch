+/* Horizontal projection scale for widescreen/FOV. 1.0 when the option is
+ * off, so the fast path costs one comparison. */
+double d3d8_display_proj_x_scale(void)
+{
+    double game_aspect, target_aspect, scale = 1.0;
+    RECT rc;
+
+    if (!g_display_opt.widescreen && g_display_opt.fov_scale == 1.0f)
+        return 1.0;
+    if (g_device_state.width == 0 || g_device_state.height == 0)
+        return 1.0;
+
+    game_aspect = (double)g_device_state.width / (double)g_device_state.height;
+
+    if (g_device_state.hwnd && GetClientRect(g_device_state.hwnd, &rc) &&
+        rc.right > rc.left && rc.bottom > rc.top)
+        target_aspect = (double)(rc.right - rc.left) / (double)(rc.bottom - rc.top);
+    else
+        target_aspect = game_aspect;
+
+    if (g_display_opt.widescreen && target_aspect > game_aspect)
+        scale = game_aspect / target_aspect;
+    if (g_display_opt.fov_scale > 0.0f && g_display_opt.fov_scale != 1.0f)
+        scale /= (double)g_display_opt.fov_scale;
+    return scale;
+}
