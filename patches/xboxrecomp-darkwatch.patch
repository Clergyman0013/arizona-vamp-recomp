+ * suspends itself. With RECOMP_GUEST_LOCK on that is exact -- the suspender
+ * holds the guest CPU, so the target is not running guest code, and it cannot
+ * take the CPU back until resumed. Without the lock it stops at its next
+ * kernel call, which is late but no longer never. Native SuspendThread is not
+ * used for these threads on either host: suspending a thread that holds a host
+ * lock (the allocator's, the guest CPU's) is how that deadlocks. */
+struct guest_thread {
+    HANDLE h;
+    long   suspend;
+    int    used;
+};
+#define GUEST_THREADS_MAX 64
+static struct guest_thread g_gthreads[GUEST_THREADS_MAX];
+static CRITICAL_SECTION g_gt_lock;
+static CONDITION_VARIABLE g_gt_cv;
+static int g_gt_ready;
+static RECOMP_TLS struct guest_thread *t_gthread;
+
+static void gt_init(void)
+{
+    if (!g_gt_ready) {             /* first call is on the creating thread */
+        InitializeCriticalSection(&g_gt_lock);
+        InitializeConditionVariable(&g_gt_cv);
+        g_gt_ready = 1;
+    }
+}
+
+struct guest_thread *guest_thread_alloc(int suspended)
+{
+    int i;
+    gt_init();
+    EnterCriticalSection(&g_gt_lock);
+    for (i = 0; i < GUEST_THREADS_MAX; i++) {
+        if (!g_gthreads[i].used) {
+            g_gthreads[i].used = 1;
+            g_gthreads[i].h = NULL;
+            g_gthreads[i].suspend = suspended ? 1 : 0;
+            LeaveCriticalSection(&g_gt_lock);
+            return &g_gthreads[i];
+        }
+    }
+    LeaveCriticalSection(&g_gt_lock);
+    return NULL;
+}
+
+void guest_thread_bind(struct guest_thread *gt, HANDLE h)
+{
+    if (!gt) return;
+    EnterCriticalSection(&g_gt_lock);
+    gt->h = h;
+    LeaveCriticalSection(&g_gt_lock);
+}
+
+void guest_thread_enter(struct guest_thread *gt)
+{
+    t_gthread = gt;
+    guest_suspend_point();
+}
+
+void guest_suspend_point(void)
+{
+    struct guest_thread *gt = t_gthread;
+    int held;
+    if (!gt || !g_gt_ready)
+        return;
+    EnterCriticalSection(&g_gt_lock);
+    if (gt->suspend <= 0) {
+        LeaveCriticalSection(&g_gt_lock);
+        return;
+    }
+    LeaveCriticalSection(&g_gt_lock);
+    held = t_guest_held;
+    if (held) {                      /* a stopped thread does not hold the CPU */
+        t_guest_held = 0;
+        cpu_release(0);
+    }
+    EnterCriticalSection(&g_gt_lock);
+    while (gt->suspend > 0)
+        SleepConditionVariableCS(&g_gt_cv, &g_gt_lock, INFINITE);
+    LeaveCriticalSection(&g_gt_lock);
+    if (held) {
+        cpu_acquire(0);
+        t_guest_held = 1;
+    }
+}
+
+/* A slot lives as long as its thread, and answers to its handle only while
+ * that handle is open. Host handle values are reused: a slot kept past either
+ * end was found first by the next thread created at the same value, so that
+ * thread's NtResumeThread went to the dead slot and it never left CREATE_
+ * SUSPENDED. Darkwatch's front end then waited 30 s for each of its three
+ * CRI workers to exit and sat on its logo. */
+void guest_thread_exit(void)
+{
+    struct guest_thread *gt = t_gthread;
+    if (!gt || !g_gt_ready)
+        return;
+    EnterCriticalSection(&g_gt_lock);
+    gt->used = 0;
+    gt->h = NULL;
+    gt->suspend = 0;
+    LeaveCriticalSection(&g_gt_lock);
+    t_gthread = NULL;
+}
+
+void guest_thread_unbind(HANDLE h)
+{
+    int i;
+    if (!h || !g_gt_ready)
+        return;
+    EnterCriticalSection(&g_gt_lock);
+    for (i = 0; i < GUEST_THREADS_MAX; i++)
+        if (g_gthreads[i].used && g_gthreads[i].h == h)
+            g_gthreads[i].h = NULL;
+    LeaveCriticalSection(&g_gt_lock);
+}
+
+static struct guest_thread *gt_find(uint32_t token, HANDLE h)
+{
+    int i;
+    if (token == 0xFFFFFFFEu)        /* NtCurrentThread() */
+        return t_gthread;
+    if (!h)
+        return NULL;
+    for (i = 0; i < GUEST_THREADS_MAX; i++)
+        if (g_gthreads[i].used && g_gthreads[i].h == h)
+            return &g_gthreads[i];
+    return NULL;
+}
+
+int guest_thread_suspend(uint32_t token, HANDLE h, ULONG *prev)
+{
+    struct guest_thread *gt;
+    if (!g_gt_ready)
+        return 0;
+    EnterCriticalSection(&g_gt_lock);
+    gt = gt_find(token, h);
+    if (gt) {
+        *prev = (ULONG)gt->suspend;
+        gt->suspend++;
+        if (getenv("RECOMP_THREAD_TRACE") && gt->suspend > 1) {
+            static int n;
+            if (n++ < 40)
+                fprintf(stderr, "  [THREAD] suspend slot %d: now %ld\n",
+                        (int)(gt - g_gthreads), gt->suspend);
+        }
+    }
+    LeaveCriticalSection(&g_gt_lock);
+    return gt != NULL;
+}
+
+int guest_thread_resume(HANDLE h, ULONG *prev)
+{
+    struct guest_thread *gt;
+    if (!g_gt_ready)
+        return 0;
+    EnterCriticalSection(&g_gt_lock);
+    gt = gt_find(0, h);
+    if (!gt && getenv("RECOMP_THREAD_TRACE")) {
+        static int n;
+        int i, used = 0;
+        for (i = 0; i < GUEST_THREADS_MAX; i++)
+            used += g_gthreads[i].used;
+        if (n++ < 10)
+            fprintf(stderr, "  [THREAD] resume of host handle %p: no guest thread"
+                    " (%d of %d slots used)\n", (void *)h, used, GUEST_THREADS_MAX);
+    }
+    if (gt) {
+        *prev = (ULONG)gt->suspend;
+        if (gt->suspend > 0 && --gt->suspend == 0)
+            WakeAllConditionVariable(&g_gt_cv);
+        if (getenv("RECOMP_THREAD_TRACE")) {
+            static int n;
+            if (n++ < 40)
+                fprintf(stderr, "  [THREAD] resume slot %d: %lu -> %ld\n",
+                        (int)(gt - g_gthreads), (unsigned long)*prev, gt->suspend);
+        }
+    }
+    LeaveCriticalSection(&g_gt_lock);
+    return gt != NULL;
+}
+
+/* Kernel calls that never block and never ready another thread.
+ *
+ * The console's scheduler switches threads when one blocks, when a wait it
+ * satisfied readies a higher (or boosted) thread, or on a quantum. A clock
+ * read is none of those, and the guest lock used to let go across it anyway:
+ * CRI's movie player reads KeQueryPerformanceCounter between steps of a
+ * stream object's lifetime, a worker ran in that gap, and the player came
+ * back to a stream whose vtable the worker had already cleared -- a crash
+ * whose position moved with the log level. Holding the CPU across these is
+ * what a single core does. Everything not listed still lets go: a call that
+ * might block has to, or two guest threads deadlock on the lock. */
+static int kernel_call_never_blocks(ULONG ordinal)
+{
+    switch (ordinal) {
+    case 51: case 52: case 53: case 54: case 55:      /* Interlocked*         */
+    case 103: case 104:                               /* KeGetCurrentIrql/Thread */
+    case 107: case 108: case 109: case 113:           /* KeInitialize*        */
+    case 124: case 125: case 126: case 127: case 128: /* KeQuery*             */
+    case 129: case 130:                               /* KeRaiseIrqlTo*       */
+    case 139: case 142:                               /* Ke{Save,Restore}FP   */
+    case 143: case 144:                               /* KeSetBasePriority... */
+    case 151:                                         /* KeStallExecution...  */
+    case 160: case 161:                               /* KfRaiseIrql/KfLower  */
+    case 165: case 166: case 167: case 168: case 171: case 172: case 173:
+    case 175: case 176: case 177: case 178: case 179: case 180: case 181:
+    case 182: case 183:                               /* Mm*                  */
+    case 184: case 199: case 204: case 217:           /* Nt*VirtualMemory     */
+    case 246: case 250: case 251:                     /* Ob*Reference*        */
+    case 260: case 261: case 262: case 263: case 267: case 268: case 269:
+    case 270: case 271: case 272: case 273: case 274: case 275: case 276:
+    case 279: case 280: case 284: case 285: case 286: case 287: case 288:
+    case 289: case 290: case 291: case 292: case 293: case 296: case 297:
+    case 298: case 299: case 300: case 301: case 304: case 305: case 306:
+    case 307: case 308: case 309: case 310: case 311: case 313: case 314:
+    case 315: case 316: case 317: case 318: case 320: /* Rtl string/memory    */
+    case 335: case 336: case 337: case 338: case 339: case 340: case 341:
+    case 342: case 343: case 344: case 345: case 346: case 347: case 348:
+    case 349: case 350: case 351:                     /* Xc* crypto           */
+        return 1;
+    default:
+        return 0;
+    }
+}
+
 /* A guest thread lets go of the guest CPU for the length of every kernel
- * call. */
+ * call that might block. */
 static void kernel_thunk_dispatch(void)
 {
     int held = t_guest_held;
+    int slot = g_kernel_dispatch_slot;
