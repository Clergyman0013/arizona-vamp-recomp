diff --git a/tests/nv2a_raster/nv2a_raster_test.c b/tests/nv2a_raster/nv2a_raster_test.c
new file mode 100644
index 0000000..b051d79
--- /dev/null
+++ b/tests/nv2a_raster/nv2a_raster_test.c
@@ -0,0 +1,258 @@
+/* The software NV2A executor end to end: methods in, pixels out.
+ *
+ * Fixed-function transform, back-face culling, the window clip, the clear
+ * rectangle, stencil, the depth clip and the image blit, each checked by
+ * reading the surface after a draw. Guest memory is a 4 GB reservation so the
+ * executor's absolute addressing (surfaces, PRAMIN, RAMHT) lands somewhere;
+ * only the pages touched are ever committed. POSIX only. */
+#include <math.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/mman.h>
+
+void nv2a_pb_exec_method(uint32_t subch, uint32_t method, uint32_t param);
+
+/* ---- what the executor links against ---------------------------------- */
+static uint8_t *g_mem;
+uint32_t g_xbox_image_lo = 0x00010000, g_xbox_image_hi = 0x00020000;
+ptrdiff_t xbox_GetMemoryOffset(void) { return (ptrdiff_t)g_mem; }
+int xbox_PhysIsContiguous(uint32_t phys) { (void)phys; return 0; }
+void xbox_FramebufferWindowSet(uint32_t va, uint32_t pitch) { (void)va; (void)pitch; }
+void xbox_FramebufferWindowSetAA(uint32_t sy) { (void)sy; }
+uint32_t g_xbox_stack_base, g_xbox_stack_size;   /* runtime state since v0.14 */
+uint32_t xbox_Nv2aFenceWordVa(void) { return 0; }
+int nv2a_pb_dma_walk(void) { return 0; }
+volatile uint32_t *xbox_Nv2aRegPtr(uint32_t offset) { (void)offset; return NULL; }
+void xbox_FramebufferWindowStart(void) {}
+void xbox_FramebufferWindowPresent(void) {}
+void xbox_FramebufferWindowFrameStats(void) {}
+void xbox_Nv2aFenceSignal(int x) { (void)x; }
+void xbox_Nv2aFrameCounterFlip(void) {}
+
+/* ---- helpers ----------------------------------------------------------- */
+#define W 64
+#define H 64
+#define PITCH (W * 4)
+#define COLOR 0x00400000u
+#define ZETA  0x00500000u
+#define VBUF  0x00600000u
+
+static int failures;
+
+static void m(uint32_t method, uint32_t param) { nv2a_pb_exec_method(0, method, param); }
+static void mf(uint32_t method, float f) { uint32_t u; memcpy(&u, &f, 4); m(method, u); }
+
+static uint32_t px(int x, int y)
+{
+    return *(uint32_t *)(g_mem + COLOR + (size_t)y * PITCH + (size_t)x * 4);
+}
+
+static void expect(const char *what, int x, int y, uint32_t want)
+{
+    uint32_t got = px(x, y);
+    if (got != want) {
+        printf("FAIL %s: pixel (%d,%d) = %08X, want %08X\n", what, x, y, got, want);
+        failures++;
+    }
+}
+
+/* Diffuse, as SET_DIFFUSE_COLOR4UB: R in the low byte. */
+static void diffuse(uint32_t argb)
+{
+    uint32_t r = (argb >> 16) & 0xFF, g = (argb >> 8) & 0xFF, b = argb & 0xFF;
+    m(0x156C, r | g << 8 | b << 16 | (argb & 0xFF000000u));
+}
+
+/* One batch of triangles from (x, y) pairs, z fixed, through vertex
+ * attribute 0 and DRAW_ARRAYS. */
+static void tris(const float *xy, int n, float z)
+{
+    float *v = (float *)(g_mem + VBUF);
+    int i;
+    for (i = 0; i < n; i++) {
+        v[i * 4 + 0] = xy[i * 2];
+        v[i * 4 + 1] = xy[i * 2 + 1];
+        v[i * 4 + 2] = z;
+        v[i * 4 + 3] = 1.0f;
+    }
+    m(0x1720, VBUF);                              /* attr 0 offset */
+    m(0x1760, 2 | 4 << 4 | 16 << 8);              /* float x4, stride 16 */
+    m(0x17FC, 5);                                 /* BEGIN TRIANGLES */
+    m(0x1810, (uint32_t)(n - 1) << 24);           /* DRAW_ARRAYS 0..n-1 */
+    m(0x17FC, 0);                                 /* END */
+}
+
+static void full_quad(float z)
+{
+    static const float q[] = {0, 0, W, 0, 0, H,  W, 0, W, H, 0, H};
+    tris(q, 6, z);
+}
+
+static void clear(uint32_t what, uint32_t colour)
+{
+    m(0x1D90, colour);                            /* COLOR_CLEAR_VALUE */
+    m(0x1D94, what);                              /* CLEAR_SURFACE */
+}
+
+/* RAMHT entry + PRAMIN instance for an object handle. */
+static void object(uint32_t handle, uint32_t inst, uint32_t cls, uint32_t base)
+{
+    uint32_t hash = (handle ^ (handle >> 11) ^ (handle >> 22)) & 0x7FF;
+    uint32_t *ent = (uint32_t *)(g_mem + 0xFD000000u + 0x700000u + hash * 8);
+    uint32_t *obj = (uint32_t *)(g_mem + 0xFD700000u + inst * 16);
+    ent[0] = handle;
+    ent[1] = inst;
+    obj[0] = cls;
+    obj[1] = 0xFFFFFFFFu;
+    obj[2] = base;
+}
+
+int main(void)
+{
+    int i;
+
+    g_mem = mmap(NULL, 1ull << 32, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANON | MAP_NORESERVE, -1, 0);
+    if (g_mem == MAP_FAILED) {
+        puts("SKIP: cannot reserve 4 GB");
+        return 0;
+    }
+
+    /* Surface: 64x64 A8R8G8B8, Z24S8. */
+    m(0x0200, 0 | W << 16);
+    m(0x0204, 0 | H << 16);
+    m(0x0208, 0x8 | 2 << 4);
+    m(0x020C, PITCH | PITCH << 16);
+    m(0x0210, COLOR);
+    m(0x0214, ZETA);
+
+    /* Fixed function, identity composite: positions are pixels. */
+    m(0x1E94, 0);                                 /* TRANSFORM_EXECUTION_MODE */
+    for (i = 0; i < 16; i++)
+        mf(0x0680 + i * 4, (i % 5) == 0 ? 1.0f : 0.0f);
+
+    /* 1. A plain draw. */
+    clear(0xF0, 0xFF000000u);
+    diffuse(0xFFFF0000u);
+    full_quad(0.5f);
+    expect("ff draw", 10, 10, 0xFFFF0000u);
+    expect("ff draw", 60, 60, 0xFFFF0000u);
+
+    /* 2. Culling: CULL_FACE BACK, FRONT_FACE CCW keeps triangles that are
+     * counter-clockwise as seen on screen (y down). */
+    m(0x0308, 1); m(0x039C, 0x0405); m(0x03A0, 0x0901);
+    {
+        static const float cw[]  = {0, 0, 32, 0, 0, 32};    /* clockwise on screen */
+        static const float ccw[] = {32, 32, 32, 63, 63, 32}; /* counter-clockwise */
+        diffuse(0xFF00FF00u);
+        tris(cw, 3, 0.5f);
+        expect("cull back", 4, 4, 0xFFFF0000u);
+        tris(ccw, 3, 0.5f);
+        expect("keep front", 36, 36, 0xFF00FF00u);
+    }
+    m(0x0308, 0);
+
+    /* 3. Window clip: rectangle 0 is x 0..16, y 0..16. */
+    m(0x02C0, 0 | 16 << 16);
+    m(0x02E0, 0 | 16 << 16);
+    diffuse(0xFFFFFFFFu);
+    full_quad(0.5f);
+    expect("window clip inside", 8, 8, 0xFFFFFFFFu);
+    expect("window clip outside", 20, 20, 0xFFFF0000u);
+    m(0x02C0, 0 | 4095u << 16);
+    m(0x02E0, 0 | 4095u << 16);
+
+    /* 4. Clear rectangle, inclusive: x 0..7, y 0..7. */
+    m(0x1D98, 0 | 7 << 16);
+    m(0x1D9C, 0 | 7 << 16);
+    clear(0xF0, 0xFF0000FFu);
+    expect("clear rect inside", 7, 7, 0xFF0000FFu);
+    expect("clear rect outside", 8, 8, 0xFFFFFFFFu);
+    m(0x1D98, 0 | 0xFFFFu << 16);
+    m(0x1D9C, 0 | 0xFFFFu << 16);
+
+    /* 5. Stencil: mark the left half with ref 1 (colour writes off), then
+     * draw where stencil == 1. */
+    clear(0xF3, 0xFF000000u);                     /* colour, Z, stencil */
+    m(0x1D8C, 0xFFFFFF00u);
+    clear(0x03, 0);
+    m(0x032C, 1);                                 /* STENCIL_TEST_ENABLE */
+    m(0x0364, 0x0207); m(0x0368, 1); m(0x036C, 0xFF);   /* ALWAYS, ref 1 */
+    m(0x0378, 0x1E01);                                  /* zpass REPLACE */
+    m(0x0358, 0);                                       /* colour mask off */
+    {
+        static const float left[] = {0, 0, 32, 0, 0, H,  32, 0, 32, H, 0, H};
+        tris(left, 6, 0.5f);
+    }
+    m(0x0358, 0x01010101u);
+    m(0x0364, 0x0202);                                  /* EQUAL */
+    m(0x0378, 0x1E00);                                  /* KEEP */
+    diffuse(0xFFFFFF00u);
+    full_quad(0.5f);
+    expect("stencil pass", 10, 30, 0xFFFFFF00u);
+    expect("stencil fail", 50, 30, 0xFF000000u);
+    m(0x032C, 0);
+
+    /* 6. Depth clip: SET_CLIP_MAX below the quad's depth discards it. */
+    clear(0xF0, 0xFF000000u);
+    mf(0x0394, 0.0f);
+    mf(0x0398, 100.0f);
+    diffuse(0xFFFFFFFFu);
+    full_quad(1000.0f);
+    expect("depth clip", 30, 30, 0xFF000000u);
+    full_quad(50.0f);
+    expect("inside depth range", 30, 30, 0xFFFFFFFFu);
+    mf(0x0398, 16777215.0f);
+
+    /* 7. Depth: an overlay at the depth of the quad under it, LEQUAL, must
+     * cover every pixel -- interpolation noise used to fail some. */
+    m(0x1D8C, 0xFFFFFF00u);
+    clear(0xF3, 0xFF000000u);
+    m(0x030C, 1); m(0x0354, 0x0203); m(0x035C, 1);
+    diffuse(0xFFFF0000u);
+    {
