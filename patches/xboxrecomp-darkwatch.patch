diff --git a/tools/recomp/test_function_needs_cf_lahf.py b/tools/recomp/test_function_needs_cf_lahf.py
new file mode 100644
index 0000000..9123004
--- /dev/null
+++ b/tools/recomp/test_function_needs_cf_lahf.py
@@ -0,0 +1,35 @@
+"""lahf consumes CF through the same "jb" condition the jcc forms use.
+
+Darkwatch's sub_00059E99 is `add ...; lahf; ...` with no jcc reading carry
+anywhere in the function, so `_function_needs_cf` said no and no `_cf` local
+was declared -- while the lahf still emitted `_cf`. The generated file then
+failed to compile: `error: use of undeclared identifier '_cf'`.
+"""
+import unittest
+
+from .disasm import Instruction
+from .translator import FunctionTranslator
+
+
+def _i(addr, mnemonic, op_str=""):
+    return Instruction(addr, 2, mnemonic, op_str, "")
+
+
+class FunctionNeedsCfLahfTest(unittest.TestCase):
+    def test_lahf_after_add_declares_cf(self):
+        insns = [_i(0, "add", "eax, ebx"), _i(2, "lahf")]
+        self.assertTrue(FunctionTranslator._function_needs_cf(insns))
+
+    def test_lahf_after_cmp_does_not_need_cf(self):
+        # A cmp publishes its operands in _fa/_fb; the lahf reads those, so
+        # no carry local is required.
+        insns = [_i(0, "cmp", "eax, ebx"), _i(2, "lahf")]
+        self.assertFalse(FunctionTranslator._function_needs_cf(insns))
+
+    def test_lahf_after_dec_needs_cf(self):
+        insns = [_i(0, "dec", "eax"), _i(2, "lahf")]
+        self.assertTrue(FunctionTranslator._function_needs_cf(insns))
+
+
+if __name__ == "__main__":
+    unittest.main()
