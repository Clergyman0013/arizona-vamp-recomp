     table = BASE + 0x20
     lifter = _lifter(table, [BASE + 0x200, *ARMS, BASE + 0x300])
     assert _arms(lifter, table + 4) == ARMS
+
+
+def test_arms_in_a_sibling_piece_do_not_end_the_table():
+    # Darkwatch's table at 0x00292020 opens with an arm in another piece of
+    # its split function. That arm is a known function start, reached through
+    # the switch's indirect-tail fallback; the local arms after it still count.
+    table = BASE + 0x20
+    sibling = BASE + 0x200
+    lifter = _lifter(table, [sibling, *ARMS, GARBAGE])
+    lifter.func_db = {sibling: {}}
+    assert _arms(lifter, table) == ARMS
+
+
+def test_an_unknown_outside_entry_still_ends_the_table():
+    table = BASE + 0x20
+    lifter = _lifter(table, [*ARMS[:2], BASE + 0x200, ARMS[2]])
+    assert _arms(lifter, table) == ARMS[:2]
diff --git a/tools/recomp/test_narrow_muldiv.py b/tools/recomp/test_narrow_muldiv.py
new file mode 100644
index 0000000..1b70bc6
--- /dev/null
+++ b/tools/recomp/test_narrow_muldiv.py
@@ -0,0 +1,65 @@
+"""One-operand mul/imul/div/idiv at 8 and 16 bits.
+
+`imul bl` is AX = AL * BL and leaves EDX alone. Lifted at 32 bits it wrote
+the high half of a 64-bit product into EDX: libpng's png_handle_IHDR computes
+the pixel depth that way while EDX holds the image height, so Darkwatch's PNGs
+all reached png_set_IHDR with height 0 and D3DX crashed decoding them.
+
+The lifted text is compiled and run against x86 results worked by hand.
+"""
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+from .disasm import Instruction, Operand
+from .lifter import Lifter
+
+
+def _lift(mnemonic, reg):
+    insn = Instruction(0, 2, mnemonic, reg, "")
+    insn.operands = [Operand(type="reg", reg=reg)]
+    return "\n".join(Lifter().lift_instruction(insn))
+
+
+CASES = [
+    # mnemonic, reg, eax, ebx, edx -> eax, edx
+    ("imul", "bl", 0x12340003, 0x000000FE, 0x000001E0, 0x1234FFFA, 0x000001E0),
+    ("mul",  "bl", 0x12340003, 0x000000FE, 0x000001E0, 0x123402FA, 0x000001E0),
+    ("div",  "bl", 0x00000107, 0x00000010, 0x55555555, 0x00000710, 0x55555555),
+    ("idiv", "bl", 0x0000FFF9, 0x00000002, 0x77777777, 0x0000FFFD, 0x77777777),
+    ("mul",  "bx", 0xAAAA1234, 0x00000100, 0xBBBB0000, 0xAAAA3400, 0xBBBB0012),
+    ("imul", "bx", 0x0000FFFF, 0x00000002, 0x00000000, 0x0000FFFE, 0x0000FFFF),
+    ("div",  "bx", 0x00000005, 0x00000002, 0x00000001, 0x00008002, 0x00000001),
+]
+
+
+class NarrowMulDivTest(unittest.TestCase):
+    def test_against_hand_worked_results(self):
+        cc = shutil.which("cc") or shutil.which("gcc") or shutil.which("clang")
+        if not cc:
+            self.skipTest("no C compiler")
+        body = []
+        for i, (m, r, a, b, d, ea, ed) in enumerate(CASES):
+            body.append(f"eax = 0x{a:08X}u; ebx = 0x{b:08X}u; edx = 0x{d:08X}u;")
+            body.append(_lift(m, r))
+            body.append(f'if (eax != 0x{ea:08X}u || edx != 0x{ed:08X}u) {{ '
+                        f'printf("case {i} {m} {r}: eax=%08X edx=%08X\\n", eax, edx); bad++; }}')
+        src = ("#include <stdint.h>\n#include <stdio.h>\n"
+               "#define LO8(x) ((x) & 0xFFu)\n#define LO16(x) ((x) & 0xFFFFu)\n"
+               "#define HI8(x) (((x) >> 8) & 0xFFu)\n"
+               "int main(void) { uint32_t eax, ebx, ecx = 0, edx; int bad = 0;\n"
+               + "\n".join(body) + "\nreturn bad; }\n")
+        with tempfile.TemporaryDirectory() as tmp:
+            c = os.path.join(tmp, "t.c")
+            exe = os.path.join(tmp, "t")
+            with open(c, "w") as f:
+                f.write(src)
+            subprocess.run([cc, "-w", "-o", exe, c], check=True)
+            r = subprocess.run([exe], capture_output=True, text=True)
+            self.assertEqual(r.returncode, 0, r.stdout + src)
+
+
+if __name__ == "__main__":
+    unittest.main()
