+/* A method for a 2D object. Returns 0 if it is none of the above. */
+static int blit_method(uint32_t subch, uint32_t method, uint32_t param)
+{
+    if (method == 0x0000) {                       /* SET_OBJECT */
+        s_2d.cls[subch & 7] = nv2a_obj_class((const uint8_t *)xbox_GetMemoryOffset(),
+                                             param);
+        return 1;
+    }
+    if (method >= 0x0180 && method < 0x0200 && method != 0x0184
+        && method != 0x0188)
+        return 1;                                 /* other DMA contexts */
+    switch (s_2d.cls[subch & 7]) {
+    case 0x62:                                    /* CONTEXT_SURFACES_2D */
+        switch (method) {
+        case 0x0184: s_2d.dma_src = param; return 1;
+        case 0x0188: s_2d.dma_dst = param; return 1;
+        case 0x0300: s_2d.format = param; return 1;
+        case 0x0304: s_2d.pitch_src = param & 0xFFFF; s_2d.pitch_dst = param >> 16; return 1;
+        case 0x0308: s_2d.off_src = param & 0x07FFFFFF; return 1;
+        case 0x030C: s_2d.off_dst = param & 0x07FFFFFF; return 1;
+        }
+        break;
+    case 0x9F:                                    /* IMAGE_BLIT */
+        switch (method) {
+        case 0x0184: case 0x0188:                 /* COLOR_KEY, CLIP contexts */
+        case 0x019C: return 1;                    /* SET_CONTEXT_SURFACES */
+        case 0x02FC: s_2d.operation = param; return 1;
+        case 0x0300: s_2d.in_x = param & 0xFFFF; s_2d.in_y = param >> 16; return 1;
+        case 0x0304: s_2d.out_x = param & 0xFFFF; s_2d.out_y = param >> 16; return 1;
+        case 0x0308:
+            if ((param & 0xFFFF) && (param >> 16))
