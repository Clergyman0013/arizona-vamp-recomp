@@ -10198,6 +10991,45 @@ static void kernel_thunk_dispatch_body(void)
         fprintf(stderr, "  [KERNEL] → returned 0x%08X\n", g_eax);
         fflush(stderr);
     }
+    /* RECOMP_KTRACE=<file>: while <file> exists, one line per kernel call --
+     * thread, ordinal, the first four arguments, the result, and the guest
+     * stack's code-looking words (the dispatch pushes a dummy return
+     * address, so the real call chain is found by scanning). For a title
+     * that loops without drawing: touch the file in the loop, delete it a
+     * moment later, and the loop's kernel traffic is the trace. */
+    {
+        static const char *trig = (const char *)-1;
+        static DWORD last_check;
+        static int on;
+        DWORD now;
+        if (trig == (const char *)-1)
+            trig = getenv("RECOMP_KTRACE");
+        if (trig) {
+            now = GetTickCount();
+            if (now - last_check > 250) {
+                FILE *f = fopen(trig, "r");
+                on = f != NULL;
+                if (f) fclose(f);
+                last_check = now;
+            }
+            if (on) {
+                uint32_t sp = g_esp - g_slot_arg_bytes[slot], k;
+                int shown = 0;
+                fprintf(stderr, "[KTRACE] t%p ord %u (%08X %08X %08X %08X)"
+                        " = %08X |", (void *)&g_eax, ordinal,
+                        BRIDGE_MEM32(sp), BRIDGE_MEM32(sp + 4),
+                        BRIDGE_MEM32(sp + 8), BRIDGE_MEM32(sp + 12), g_eax);
+                for (k = 0; k < 96 && shown < 8; k++) {
+                    uint32_t w = BRIDGE_MEM32(g_esp + k * 4);
+                    if (w >= 0x00011000u && w < 0x00400000u) {
+                        fprintf(stderr, " %08X", w);
+                        shown++;
+                    }
