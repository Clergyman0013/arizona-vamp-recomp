+/* ── DSP boot ROM: scratch memory into P-RAM ─────────────────────────────
+ *
+ * When a DSP comes out of reset (GPRST/EPRST bit 0 going 0 -> 1) its boot ROM
+ * DMAs the first 0x800 words of scratch memory into program RAM -- xemu's
+ * dsp_bootstrap(). DirectSound relies on that: it stages the EP image (the
+ * DOLBY section) in scratch, releases the reset, and later checks P:6 of the
+ * EP for the image's 0xCCCCCC signature. Without the copy P-RAM stays zero,
+ * so every service pass resets both DSPs again with a 10 ms stall each time;
+ * Darkwatch's level load spent all its time there.
+ *
+ * The GP and EP windows (APU + 0x30000, + 0x50000) are plain memory, not
+ * trapped (see MemoryLayoutInit), so the reset registers are polled once per
+ * APU frame rather than seen on the store; the memory layout says where the
+ * windows are. A reset pulse shorter than a frame is missed, which costs
+ * nothing while scratch still holds the same image. */
+#define DSP_BOOT_WORDS 0x800u
+
+static uint8_t *s_dsp_windows;   /* host address of APU + 0; NULL: not polled */
+
+void mcpx_apu_dsp_set_windows(void *apu_base)
+{
+    s_dsp_windows = (uint8_t *)apu_base;
+}
+
+static void dsp_bootstrap(MCPXAPUState *d, int i)
+{
+    static const char *const name[2] = { "GP", "EP" };
+    static int shown[2];
+    uint32_t sge = d->regs[i ? NV_PAPU_EPSADDR : NV_PAPU_GPSADDR], off;
+    uint32_t *pram = (uint32_t *)(s_dsp_windows + (i ? 0x50000u : 0x30000u)
+                                  + NV_PAPU_GPPMEM);
+
+    for (off = 0; off < DSP_BOOT_WORDS * 4; off += 4) {
+        uint32_t page = ldl_le_phys(NULL, sge + (off >> 12) * 8) & ~0xFFFu;
+        if (!page)
+            break;
+        pram[off / 4] = ldl_le_phys(NULL, page + (off & 0xFFFu)) & 0xFFFFFFu;
+    }
+    if (shown[i]++ < 3)
+        fprintf(stderr, "[APU] %s out of reset: scratch booted into P-RAM"
+                        " (P:6 = 0x%06X)\n", name[i], pram[6]);
+}
+
+static void dsp_bootstrap_poll(MCPXAPUState *d)
+{
+    static uint32_t prev[2];
+    int i;
+
+    if (!s_dsp_windows)
+        return;
+    for (i = 0; i < 2; i++) {
+        uint32_t rst = *(volatile uint32_t *)(s_dsp_windows
+                                              + (i ? 0x50000u : 0x30000u)
+                                              + NV_PAPU_GPRST);
+        if (!d->regs[i ? NV_PAPU_EPSADDR : NV_PAPU_GPSADDR])
+            continue;   /* no scratch yet: wait, keep the edge */
+        if ((rst & NV_PAPU_GPRST_GPRST) && !(prev[i] & NV_PAPU_GPRST_GPRST))
+            dsp_bootstrap(d, i);
+        prev[i] = rst;
+    }
+}
