diff --git a/src/kernel/nv2a_ff.c b/src/kernel/nv2a_ff.c
new file mode 100644
index 0000000..8a4ccd1
--- /dev/null
+++ b/src/kernel/nv2a_ff.c
@@ -0,0 +1,524 @@
+/*
+ * NV2A fixed-function transform and lighting. See nv2a_ff.h.
+ *
+ * Derived from xemu's fixed-function vertex shader generator and its method
+ * handlers (hw/xbox/nv2a/pgraph/glsl/vsh-ff.c, hw/xbox/nv2a/pgraph/pgraph.c):
+ *   Copyright (c) 2012 espes
+ *   Copyright (c) 2015 Jannik Vogel
+ *   Copyright (c) 2020-2025 Matt Borgerson
+ * Licensed under the GNU Lesser General Public License, version 2.1 or (at
+ * your option) any later version; see LICENSES/LGPL-2.1.txt and NOTICE.
+ *
+ * xemu generates GLSL from this state; here the same arithmetic runs in C,
+ * once per vertex, and writes an Nv2aVshOutput the rasteriser already takes
+ * from vertex programs. Where xemu leaves something out (two-sided lighting,
+ * the spot falloff curve, the texgen view model) so does this.
+ */
+#include "nv2a_ff.h"
+
+#include <math.h>
+#include <string.h>
+
+/* Transform constant rows (NV_IGRAPH_XF_XFCTX_*). */
+#define XF_CMAT0  0x00
+#define XF_PMAT0  0x04
+#define XF_MMAT0  0x08
+#define XF_IMMAT0 0x0c
+#define XF_EYEP   0x38
+#define XF_FOG    0x39
+#define XF_TG0MAT 0x40
+#define XF_T0MAT  0x44
+
+enum { SRC_MATERIAL = 0, SRC_DIFFUSE = 1, SRC_SPECULAR = 2 };
+enum { LIGHT_OFF = 0, LIGHT_INFINITE = 1, LIGHT_LOCAL = 2, LIGHT_SPOT = 3 };
+
+typedef struct {
+    float amb[3], dif[3], spc[3];
+    float range;
+    float half[3], dir[3];
+    float falloff[3], spot[4];
+    float pos[3], att[3];
+} FfLight;
+
+static struct {
+    int      composite_set;
+    uint32_t lighting, specular_enable, normalize, skin;
+    uint32_t light_mask, light_control, color_material, fog_gen;
+    uint32_t texgen[4][4], texmat_enable[4];
+    float    emission[3], material_alpha, scene_ambient[3];
+    float    spec_params[6], spec_power;
+    FfLight  light[8];
+} s_ff;
+
+static float as_float(uint32_t u)
+{
+    float f;
+    memcpy(&f, &u, 4);
+    return f;
+}
+
+/* ---- specular power -----------------------------------------------------
+ *
+ * D3D does not send the material's power. It sends six coefficients of a
+ * curve the hardware evaluates in place of pow(), and the power has to be
+ * recovered from them (xemu, after xgu's xgux.h). */
+typedef struct { float a, b, c; } Curve;
+
+static const Curve k_curves[] = {
+    {1.000108475163f, -9.838607076280f, 54.829089549713f},
+    {1.199164441703f, -3.292603784852f, 7.799987995214f},
+    {8.653441252033f, 29.189473787191f, 43.586027561823f},
+    {-531.307758450301f, 117.398468683934f, 113.155490738338f},
+    {-4.662713151292f, 1.221108944572f, 1.217360986939f},
+    {-124.435242105211f, 35.401219563514f, 35.408114377045f},
+    {10672560.259502287954f, 21565843.555823743343f, 10894794.336297152564f},
+    {-51973801.463933646679f, -104199997.554352939129f, -52225454.356278456748f},
+    {972270.324080004124f, 2025882.096547174733f, 1054898.052467488218f},
+};
+static const float k_steps[] = {
+    -0.022553957999f, -0.421539008617f, -0.678715527058f, -0.838916420937f,
+    -0.961754500866f, -0.990773200989f, -0.994858562946f, -0.996561050415f,
+    -0.999547004700f,
+};
+/* Ranges 3..5 are fitted as a saturation-growth rate, the rest quadratic. */
+static float curve_eval(int i, float c0)
+{
+    const Curve *k = &k_curves[i];
+    if (i >= 3 && i <= 5)
+        return (k->a * c0) / (k->b + k->c * c0);
+    return k->a + k->b * c0 + k->c * c0 * c0;
+}
+
+static float curve_power(float c)
+{
+    int i;
+    for (i = 0; i < (int)(sizeof k_steps / sizeof k_steps[0]); i++)
+        if (c > k_steps[i])
+            return curve_eval(i, c);
+    return 0.0f;
+}
+
+static float specular_power(const float *p)
+{
+    float pw, half;
+    if (p[1] > 0.0f && p[2] < 1.0f)
+        return p[2] - p[0] * 2.0f;
+    if (p[0] > 0.0f || p[3] > 0.0f)
+        return 0.0001f;
+    pw = curve_power(p[0]);
+    half = curve_power(p[3]);
+    if (pw == 0.0f || (half > pw && p[0] < -0.1f))
+        return half * 2.0f;
+    return pw;
+}
+
+/* ---- methods ------------------------------------------------------------ */
+
+static void set_const(uint32_t row, uint32_t comp, uint32_t param)
+{
+    nv2a_vsh_constant_component(row, comp, param);
+}
+
+static void set3(float *dst, uint32_t idx, uint32_t param)
+{
+    if (idx < 3)
+        dst[idx] = as_float(param);
+}
+
+static int light_method(uint32_t method, uint32_t param)
+{
+    uint32_t off, i, k;
+    FfLight *l;
+
+    if (method >= 0x0C00 && method < 0x0E00)     /* SET_BACK_LIGHT_*: */
+        return 1;                                 /* two-sided: not drawn */
+    if (method < 0x1000 || method >= 0x1400)
+        return 0;
+    i = (method - 0x1000) / 0x80;
+    off = (method - 0x1000) % 0x80;
+    l = &s_ff.light[i];
+    k = (off % 0x0C) / 4;
+    if (off < 0x0C)        set3(l->amb, k, param);
+    else if (off < 0x18)   set3(l->dif, (off - 0x0C) / 4, param);
+    else if (off < 0x24)   set3(l->spc, (off - 0x18) / 4, param);
+    else if (off == 0x24)  l->range = as_float(param);
+    else if (off < 0x34)   set3(l->half, (off - 0x28) / 4, param);
+    else if (off < 0x40)   set3(l->dir, (off - 0x34) / 4, param);
+    else if (off < 0x4C)   set3(l->falloff, (off - 0x40) / 4, param);
+    else if (off < 0x5C)   l->spot[(off - 0x4C) / 4] = as_float(param);
+    else if (off < 0x68)   set3(l->pos, (off - 0x5C) / 4, param);
+    else if (off < 0x74)   set3(l->att, (off - 0x68) / 4, param);
+    return 1;
+}
+
+static uint32_t texgen_mode(uint32_t param)
+{
+    switch (param) {
+    case 0x2400: return 1;                        /* EYE_LINEAR      */
+    case 0x2401: return 2;                        /* OBJECT_LINEAR   */
+    case 0x2402: return 3;                        /* SPHERE_MAP      */
+    case 0x8512: return 4;                        /* REFLECTION_MAP  */
+    case 0x8511: return 5;                        /* NORMAL_MAP      */
+    default:     return 0;                        /* DISABLE         */
+    }
+}
+
+int nv2a_ff_method(uint32_t method, uint32_t param)
+{
+    uint32_t slot;
+
+    switch (method) {
+    case 0x0294: s_ff.light_control = param; return 1;   /* LIGHT_CONTROL   */
+    case 0x0298: s_ff.color_material = param; return 1;  /* COLOR_MATERIAL  */
+    case 0x02A0: s_ff.fog_gen = param; return 1;         /* FOG_GEN_MODE    */
+    case 0x0314: s_ff.lighting = param; return 1;        /* LIGHTING_ENABLE */
+    case 0x0328: s_ff.skin = param; return 1;            /* SKIN_MODE       */
+    case 0x03A4: s_ff.normalize = param; return 1;       /* NORMALIZATION   */
+    case 0x03B4: s_ff.material_alpha = as_float(param); return 1;
+    case 0x03B8: s_ff.specular_enable = param; return 1; /* SPECULAR_ENABLE */
+    case 0x03BC: s_ff.light_mask = param; return 1;      /* LIGHT_ENABLE_MASK */
+    case 0x09CC: return 1;                               /* TEXGEN_VIEW_MODEL */
+    default: break;
+    }
+    if (method >= 0x03A8 && method < 0x03B4) {           /* MATERIAL_EMISSION */
+        set3(s_ff.emission, (method - 0x03A8) / 4, param);
+        return 1;
+    }
+    if (method >= 0x03C0 && method < 0x0400) {           /* TEXGEN_S/T/R/Q  */
+        slot = (method - 0x03C0) / 4;
+        s_ff.texgen[slot / 4][slot % 4] = texgen_mode(param);
+        return 1;
+    }
+    if (method >= 0x0420 && method < 0x0430) {           /* TEXTURE_MATRIX_ENABLE */
+        s_ff.texmat_enable[(method - 0x0420) / 4] = param;
+        return 1;
+    }
+    if (method >= 0x0440 && method < 0x0480) {           /* PROJECTION_MATRIX */
+        slot = (method - 0x0440) / 4;
+        set_const(XF_PMAT0 + slot / 4, slot % 4, param);
+        return 1;
+    }
+    if (method >= 0x0480 && method < 0x0680) {           /* MODEL_VIEW, INVERSE */
+        uint32_t inv = method >= 0x0580;
+        slot = (method - (inv ? 0x0580 : 0x0480)) / 4;
+        set_const((inv ? XF_IMMAT0 : XF_MMAT0) + (slot / 16) * 8
+                  + (slot % 16) / 4, slot % 4, param);
+        return 1;
+    }
+    if (method >= 0x0680 && method < 0x06C0) {           /* COMPOSITE_MATRIX */
+        slot = (method - 0x0680) / 4;
+        set_const(XF_CMAT0 + slot / 4, slot % 4, param);
+        s_ff.composite_set = 1;
+        return 1;
+    }
+    if (method >= 0x06C0 && method < 0x07C0) {           /* TEXTURE_MATRIX  */
+        slot = (method - 0x06C0) / 4;
+        set_const(XF_T0MAT + (slot / 16) * 8 + (slot % 16) / 4, slot % 4, param);
+        return 1;
+    }
+    if (method >= 0x0840 && method < 0x0940) {           /* TEXGEN_PLANE_*  */
+        slot = (method - 0x0840) / 4;
+        set_const(XF_TG0MAT + (slot / 16) * 8 + (slot % 16) / 4, slot % 4, param);
+        return 1;
+    }
+    if (method >= 0x09D0 && method < 0x09E0) {           /* FOG_PLANE       */
+        set_const(XF_FOG, (method - 0x09D0) / 4, param);
+        return 1;
+    }
+    if (method >= 0x09E0 && method < 0x09F8) {           /* SPECULAR_PARAMS */
+        slot = (method - 0x09E0) / 4;
+        s_ff.spec_params[slot] = as_float(param);
+        if (slot == 5)
+            s_ff.spec_power = specular_power(s_ff.spec_params);
+        return 1;
+    }
+    if (method >= 0x0A10 && method < 0x0A1C) {           /* SCENE_AMBIENT   */
+        set3(s_ff.scene_ambient, (method - 0x0A10) / 4, param);
+        return 1;
+    }
+    if (method >= 0x0A30 && method < 0x0A50)             /* POINT_PARAMS    */
+        return 1;
+    if (method >= 0x0A50 && method < 0x0A60) {           /* EYE_POSITION    */
+        set_const(XF_EYEP, (method - 0x0A50) / 4, param);
+        return 1;
+    }
+    if (method >= 0x1E28 && method < 0x1E40)             /* SPECULAR_PARAMS_BACK */
+        return 1;
+    return light_method(method, param);
+}
+
+int nv2a_ff_ready(void)
+{
+    return s_ff.composite_set;
+}
+
+/* ---- evaluation --------------------------------------------------------- */
+
+static float dot3(const float *a, const float *b)
+{
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+static float dot4(const float *a, const float *b)
+{
+    return a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
+}
+
+static void normalize3(float *v)
+{
+    float l = sqrtf(dot3(v, v));
+    if (l > 0.0f) {
+        v[0] /= l; v[1] /= l; v[2] /= l;
+    }
+}
+
+/* v * M for the 4x4 matrix whose columns are constant rows base..base+3. */
+static void xform4(const float *v, uint32_t base, float *out)
+{
+    float r[4];
+    int j;
+    for (j = 0; j < 4; j++)
+        r[j] = dot4(v, nv2a_vsh_constant(base + j));
+    memcpy(out, r, sizeof r);
+}
+
+/* Skinning: how many matrices, and whether the last weight is implied. */
+static void skin_shape(uint32_t mode, int *count, int *mix)
+{
+    static const int counts[7] = {0, 2, 2, 3, 3, 4, 4};
+    static const int mixes[7]  = {0, 1, 0, 1, 0, 1, 0};
+    if (mode > 6) mode = 0;
+    *count = counts[mode];
+    *mix = mixes[mode];
+}
+
+static void skin(const float *v, const float *weight, uint32_t base,
+                 int count, int mix, int ncomp, float *out)
+{
+    float t[4];
+    int i, j;
+
+    if (count == 0) {
+        xform4(v, base, t);
+        memcpy(out, t, sizeof(float) * ncomp);
+        return;
+    }
+    for (j = 0; j < ncomp; j++)
+        out[j] = 0.0f;
+    {
+        float rest = 1.0f;
+        for (i = 0; i < count; i++) {
+            float w;
+            if (mix) {
+                w = i < count - 1 ? weight[i] : rest;
+                rest -= w;
+            } else {
+                w = weight[i];
+            }
+            xform4(v, base + (uint32_t)i * 8, t);
+            for (j = 0; j < ncomp; j++)
+                out[j] += t[j] * w;
+        }
+    }
+}
+
+static float clamp01(float f)
+{
+    return f < 0.0f ? 0.0f : (f > 1.0f ? 1.0f : f);
+}
+
+static float clamp_away_zero_inf(float t)
+{
+    float a = fabsf(t);
+    if (a < 5.42101e-20f) a = 5.42101e-20f;
+    if (a > 1.884467e+19f || a != a) a = 1.884467e+19f;
+    return t < 0.0f ? -a : a;
+}
+
+static void lighting(const float in[NV2A_VSH_INPUTS][4], const float *tpos,
+                     const float *tn, float *d0, float *d1)
+{
+    const float *diffuse = in[3], *specular = in[4];
+    uint32_t cm = s_ff.color_material;
+    uint32_t emission_src = cm & 3, ambient_src = (cm >> 2) & 3;
+    uint32_t diffuse_src = (cm >> 4) & 3, specular_src = (cm >> 6) & 3;
+    int local_eye = (s_ff.light_control >> 16) & 1;
+    float alpha, vpeye[3] = {0, 0, 0};
+    int i, k;
+
+    alpha = diffuse_src == SRC_MATERIAL ? s_ff.material_alpha
+          : diffuse_src == SRC_SPECULAR ? specular[3] : diffuse[3];
+
+    if (ambient_src == SRC_DIFFUSE)       memcpy(d0, diffuse, 12);
+    else if (ambient_src == SRC_SPECULAR) memcpy(d0, specular, 12);
+    else                                  memcpy(d0, s_ff.scene_ambient, 12);
+    d0[3] = alpha;
+    for (k = 0; k < 3; k++)
+        d0[k] *= s_ff.emission[k];
+    for (k = 0; k < 3; k++)
+        d0[k] += emission_src == SRC_DIFFUSE ? diffuse[k]
+               : emission_src == SRC_SPECULAR ? specular[k]
+               : s_ff.scene_ambient[k];
+    d1[0] = d1[1] = d1[2] = 0.0f;
+    d1[3] = specular[3];
+
+    if (local_eye) {
+        const float *e = nv2a_vsh_constant(XF_EYEP);
+        float ew = e[3] != 0.0f ? e[3] : 1.0f, tw = tpos[3] != 0.0f ? tpos[3] : 1.0f;
+        for (k = 0; k < 3; k++)
+            vpeye[k] = e[k] / ew - tpos[k] / tw;
+        normalize3(vpeye);
+    }
+
+    for (i = 0; i < 8; i++) {
+        uint32_t type = (s_ff.light_mask >> (i * 2)) & 3;
+        const FfLight *l = &s_ff.light[i];
+        float att = 1.0f, ndotvp, ndothv, pf, vp[3], hv[3];
+
+        if (type == LIGHT_OFF)
+            continue;
+        if (type == LIGHT_INFINITE) {
+            memcpy(vp, l->dir, sizeof vp);
+            normalize3(vp);
+            ndotvp = fmaxf(0.0f, dot3(tn, vp));
+            if (local_eye) {
+                for (k = 0; k < 3; k++) hv[k] = vp[k] + vpeye[k];
+                normalize3(hv);
+                ndothv = fmaxf(0.0f, dot3(tn, hv));
+            } else {
+                ndothv = fmaxf(0.0f, dot3(tn, l->half));
+            }
+        } else {
+            float tw = tpos[3] != 0.0f ? tpos[3] : 1.0f, d;
+            for (k = 0; k < 3; k++)
+                vp[k] = l->pos[k] - tpos[k] / tw;
+            d = sqrtf(dot3(vp, vp));
+            if (d > l->range)
+                continue;
+            normalize3(vp);
+            att = l->att[0] + l->att[1] * d + l->att[2] * d * d;
+            att = att != 0.0f ? 1.0f / att : 1.0f;
+            for (k = 0; k < 3; k++) hv[k] = vp[k] + vpeye[k];
+            normalize3(hv);
+            ndotvp = fmaxf(0.0f, dot3(tn, vp));
+            ndothv = fmaxf(0.0f, dot3(tn, hv));
+            if (type == LIGHT_SPOT) {
+                float len = sqrtf(dot3(l->spot, l->spot));
+                float inv = len > 0.0f ? 1.0f / len : 0.0f;
+                float cos_phi = -inv * l->spot[3];
+                float cos_theta = inv + cos_phi;
+                float sdv = dot3(l->spot, vp), rho = inv * sdv;
+                if (rho > cos_theta)
+                    ;
+                else if (rho <= cos_phi)
+                    att = 0.0f;
+                else
+                    att *= sdv + l->spot[3];
+            }
+        }
+        pf = (ndotvp == 0.0f || ndothv == 0.0f) ? 0.0f
+           : powf(ndothv, s_ff.spec_power);
+        for (k = 0; k < 3; k++) {
+            float ld = l->dif[k] * att * ndotvp, ls = l->spc[k] * att * pf;
+            d0[k] += l->amb[k] * att;
+            d0[k] += diffuse_src == SRC_DIFFUSE ? diffuse[k] * ld
+                   : diffuse_src == SRC_SPECULAR ? specular[k] * ld : ld;
+            d1[k] += specular_src == SRC_DIFFUSE ? diffuse[k] * ls
+                   : specular_src == SRC_SPECULAR ? specular[k] * ls : ls;
+        }
+    }
+}
+
+void nv2a_ff_run(const float in[NV2A_VSH_INPUTS][4], int fog_enable,
+                 Nv2aVshOutput *out)
+{
+    const float *position = in[0], *weight = in[1];
+    float tpos[4], tn[3], n4[4], p[4];
+    int count, mix, i, j, k;
+
+    memset(out, 0, sizeof *out);
+    skin_shape(s_ff.skin, &count, &mix);
+    skin(position, weight, XF_MMAT0, count, mix, 4, tpos);
+    n4[0] = in[2][0]; n4[1] = in[2][1]; n4[2] = in[2][2]; n4[3] = 0.0f;
+    skin(n4, weight, XF_IMMAT0, count, mix, 3, tn);
+    if (s_ff.normalize)
+        normalize3(tn);
+
+    /* Texgen, then the texture matrix. */
+    for (i = 0; i < 4; i++) {
+        float *t = out->tex[i];
+        for (j = 0; j < 4; j++) {
+            const float *plane = nv2a_vsh_constant(XF_TG0MAT + (uint32_t)i * 8 + (uint32_t)j);
+            switch (s_ff.texgen[i][j]) {
+            case 1: t[j] = dot4(plane, tpos); break;
+            case 2: t[j] = dot4(plane, position); break;
+            case 3: case 4: {
+                float u[3], r[3], d;
+                memcpy(u, tpos, sizeof u);
+                normalize3(u);
+                d = 2.0f * dot3(tn, u);
+                for (k = 0; k < 3; k++) r[k] = u[k] - d * tn[k];
+                if (s_ff.texgen[i][j] == 4) {
+                    t[j] = j < 3 ? r[j] : 0.0f;
+                } else {
+                    float m[3] = {r[0], r[1], r[2] + 1.0f};
+                    float l = sqrtf(dot3(m, m));
+                    t[j] = j < 2 ? (l > 0.0f ? r[j] / (2.0f * l) : 0.0f) + 0.5f : 0.0f;
+                }
+                break;
+            }
+            case 5: t[j] = j < 3 ? tn[j] : 0.0f; break;
+            default: t[j] = in[9 + i][j]; break;
+            }
+        }
+        if (s_ff.texmat_enable[i])
+            xform4(t, XF_T0MAT + (uint32_t)i * 8, t);
+    }
+
+    if (!s_ff.lighting) {
+        memcpy(out->d0, in[3], sizeof out->d0);
+        memcpy(out->d1, in[4], sizeof out->d1);
+    } else {
+        lighting(in, tpos, tn, out->d0, out->d1);
+    }
+    if (!s_ff.specular_enable) {
+        out->d1[0] = out->d1[1] = out->d1[2] = 0.0f;
+        out->d1[3] = 1.0f;
+    } else if (!(s_ff.light_control & 1)) {       /* not SEPARATE_SPECULAR */
+        if (s_ff.lighting)
+            for (k = 0; k < 3; k++)
+                out->d0[k] += out->d1[k];
+        memcpy(out->d1, in[4], sizeof out->d1);
+    }
+    for (k = 0; k < 4; k++) {
+        out->d0[k] = clamp01(out->d0[k]);
+        out->d1[k] = clamp01(out->d1[k]);
+    }
+
+    if (fog_enable) {
+        float d;
+        switch (s_ff.fog_gen) {
+        case 0: d = clamp01(in[4][3]); break;     /* SPEC_ALPHA */
+        case 1: d = sqrtf(dot3(tpos, tpos)); break; /* RADIAL */
+        case 2: case 3: {                         /* PLANAR, ABS_PLANAR */
+            const float *fp = nv2a_vsh_constant(XF_FOG);
+            d = dot3(fp, tpos) + fp[3];
+            if (s_ff.fog_gen == 3) d = fabsf(d);
+            break;
+        }
+        default: d = in[5][0]; break;             /* FOG_X */
+        }
+        out->fog[0] = out->fog[1] = out->fog[2] = out->fog[3] = d;
+    }
+
+    /* With skinning off the composite matrix already includes model-view. */
+    xform4(count == 0 ? position : tpos, XF_CMAT0, p);
+    p[3] = clamp_away_zero_inf(p[3]);
+    {
+        const float *vpoff = nv2a_vsh_constant(59);
+        out->pos[0] = p[0] / p[3] + vpoff[0];
+        out->pos[1] = p[1] / p[3] + vpoff[1];
+        out->pos[2] = p[2] / p[3];
+        out->pos[3] = p[3];
+    }
+}
diff --git a/src/kernel/nv2a_ff.h b/src/kernel/nv2a_ff.h
new file mode 100644
index 0000000..d69c407
--- /dev/null
+++ b/src/kernel/nv2a_ff.h
@@ -0,0 +1,40 @@
+/**
+ * NV2A fixed-function transform and lighting, for the software pushbuffer
+ * executor.
+ *
+ * A batch drawn with TRANSFORM_EXECUTION_MODE = FIXED carries model-space
+ * vertices and expects the GPU's own transform, lighting, texgen and fog
+ * units to run on them. The executor used to draw such a batch only if its
+ * positions happened to look like pixels, and drop it otherwise. This keeps
+ * the fixed-function state the methods carry and evaluates it per vertex,
+ * producing the same Nv2aVshOutput a vertex program does.
+ *
+ * Matrices, texgen planes, the fog plane and the eye position live in the
+ * transform constant file, where the hardware keeps them (XFCTX rows 0x00 to
+ * 0x5F); the rest is kept here.
+ *
+ * Semantics follow xemu's fixed-function shader generator
+ * (hw/xbox/nv2a/pgraph/glsl/vsh-ff.c); see NOTICE.
+ */
+#ifndef XBOXRECOMP_NV2A_FF_H
+#define XBOXRECOMP_NV2A_FF_H
+
+#include <stdint.h>
+#include "nv2a_vsh_interp.h"
+
+/* Consume one NV097 method if it is fixed-function T&L state. Returns 1 if
+ * it was. */
+int  nv2a_ff_method(uint32_t method, uint32_t param);
+
+/* Whether the title has given the fixed-function path anything to work
+ * with: a composite matrix. Without one a FIXED batch is pre-transformed
+ * screen-space data and is drawn as such. */
+int  nv2a_ff_ready(void);
+
+/* Transform one vertex. in[] is v0..v15 in the fixed-function layout
+ * (position, weight, normal, diffuse, specular, fog, point size, back
+ * diffuse, back specular, texture 0..3). fog_enable is SET_FOG_ENABLE. */
+void nv2a_ff_run(const float in[NV2A_VSH_INPUTS][4], int fog_enable,
+                 Nv2aVshOutput *out);
+
+#endif
