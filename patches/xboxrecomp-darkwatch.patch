+/* ---- 2D: surfaces, beta, image blit ------------------------------------
+ *
+ * D3D keeps NV062 (2D surfaces), NV09F (image blit) and NV012 (beta) bound on
+ * the other subchannels and uses them for CopyRects, surface-to-surface
+ * copies and some resolve paths. The rasteriser draws straight into guest
+ * memory, so a blit is a copy in guest memory (xemu pgraph/gl/blit.c). */
+static struct {
+    uint32_t cls[8];                    /* graphics class per subchannel */
+    uint32_t dma_src, dma_dst, format, pitch_src, pitch_dst, off_src, off_dst;
+    uint32_t operation, in_x, in_y, out_x, out_y;
+    uint32_t beta;
+    uint32_t blits;
+} s_2d;
+
+static uint32_t blit_addr(uint32_t dma, uint32_t offset)
+{
+    uint32_t base = 0, limit = 0;
+    nv2a_dma_lookup((const uint8_t *)xbox_GetMemoryOffset(), dma, &base, &limit);
+    return dma_resolve(base + offset);
+}
+
+static void image_blit(uint32_t w, uint32_t h)
+{
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset();
+    uint32_t bpp, src, dst, row, y, x;
+
+    switch (s_2d.format) {
+    case 0x01: bpp = 1; break;                    /* Y8 */
+    case 0x04: bpp = 2; break;                    /* R5G6B5 */
+    case 0x06: case 0x07: case 0x0A: case 0x0B: bpp = 4; break;
+    default: return;
+    }
+    src = blit_addr(s_2d.dma_src, s_2d.off_src)
+        + s_2d.in_y * s_2d.pitch_src + s_2d.in_x * bpp;
+    dst = blit_addr(s_2d.dma_dst, s_2d.off_dst)
+        + s_2d.out_y * s_2d.pitch_dst + s_2d.out_x * bpp;
+    row = w * bpp;
+    if (s_2d.pitch_src && row > s_2d.pitch_src) row = s_2d.pitch_src;
+    if (s_2d.pitch_dst && row > s_2d.pitch_dst) row = s_2d.pitch_dst;
+    if (surface_write_refused(dst, (h - 1) * s_2d.pitch_dst + row, "blit to"))
+        return;
+    s_2d.blits++;
+    if (s_2d.operation == 2 && bpp == 4) {        /* BLEND_AND, by beta */
+        uint32_t bm = s_2d.beta >> 16, ibm = 0x7F80 - bm;
+        for (y = 0; y < h; y++) {
+            uint8_t *sp = mem + src + (size_t)y * s_2d.pitch_src;
+            uint8_t *dp = mem + dst + (size_t)y * s_2d.pitch_dst;
+            for (x = 0; x < row; x++)
+                if ((x & 3) != 3)
+                    dp[x] = (uint8_t)((sp[x] * bm + dp[x] * ibm) / 0x7F80);
+        }
+    } else {
+        for (y = 0; y < h; y++)                   /* SRCCOPY */
+            memmove(mem + dst + (size_t)y * s_2d.pitch_dst,
+                    mem + src + (size_t)y * s_2d.pitch_src, row);
+    }
+    /* The X formats write a fixed alpha: 0xFF for X8R8G8B8, 0 for
+     * X8R8G8B8_Z8R8G8B8 (xemu). */
+    if (s_2d.format == 0x07 || s_2d.format == 0x06) {
+        uint8_t a = s_2d.format == 0x07 ? 0xFF : 0x00;
+        for (y = 0; y < h; y++)
+            for (x = 3; x < row; x += 4)
+                mem[dst + (size_t)y * s_2d.pitch_dst + x] = a;
+    }
+}
