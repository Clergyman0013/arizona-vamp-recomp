diff --git a/tools/disasm/test_this_adjust_thunk.py b/tools/disasm/test_this_adjust_thunk.py
new file mode 100644
index 0000000..3f92fbd
--- /dev/null
+++ b/tools/disasm/test_this_adjust_thunk.py
@@ -0,0 +1,243 @@
+"""MSVC's this-adjust thunk is a function, and the ret-probe rejected it.
+
+    mov ecx, [esp+4]            8B 4C 24 04
+    jmp <method>                E9 <rel32>
+
+    add ecx, <imm>              83 C1 <imm8>  /  81 C1 <imm32>
+    jmp <method>
+
+Darkwatch packs these immediately after a ret and names them with `push imm32`
+or with a jump from another thunk. They never reach a ret, and the jump is
+direct, so neither probes_as_returning_body nor probes_as_vcall_thunk matches.
+Each missed one is an indirect call the runtime skips.
+"""
+import os
+import struct
+import sys
+import unittest
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", ".."))
+
+from capstone import Cs, CS_ARCH_X86, CS_MODE_32  # noqa: E402
+
+from tools.disasm.engine import DisasmEngine  # noqa: E402
+from tools.disasm.functions import Function, FunctionDetector  # noqa: E402
+
+
+class _Section:
+    def __init__(self, va, size, executable=True, name=".text"):
+        self.virtual_addr = va
+        self.virtual_size = size
+        self.executable = executable
+        self.name = name
+
+
+class _Image:
+    def __init__(self, va, data, executable=True):
+        self.va = va
+        self.data = data
+        self.section = _Section(va, len(data), executable)
+        self.base_address = va
+        self.image_size = len(data)
+
+    def get_section_at_va(self, addr):
+        if self.va <= addr < self.va + len(self.data):
+            return self.section
+        return None
+
+    def read_bytes_at_va(self, addr, n):
+        off = addr - self.va
+        if off < 0 or off >= len(self.data):
+            return b""
+        return self.data[off:off + n]
+
+    def get_section_data(self, section):
+        return self.data
+
+
+def _engine(data, va=0x001D4CC0, executable=True):
+    eng = DisasmEngine.__new__(DisasmEngine)
+    eng.image = _Image(va, data, executable)
+    eng._cs = Cs(CS_ARCH_X86, CS_MODE_32)
+    eng._cs.detail = True
+    eng.instructions = {}
+    eng._sorted_addrs = None
+    return eng, va
+
+
+def _rel32(src_after, target):
+    disp = target - src_after
+    if disp >= 0x80000000:
+        disp -= 0x100000000
+    return struct.pack("<i", disp)
+
+
+# mov ecx, [esp+4]; jmp 0x1D4BEF   (the 0x001D4CC0 bytes, target relative)
+STACK_THUNK = bytes.fromhex("8b4c2404") + b"\xe9" + _rel32(0x001D4CC0 + 9, 0x001D4BEF)
+ADD8_THUNK = bytes.fromhex("83c10c") + b"\xe9" + _rel32(0x000EABF6 + 8, 0x000CAA17)
+ADD32_THUNK = bytes.fromhex("81c190000000") + b"\xe9" + _rel32(0x0006FC44 + 11, 0x002277D6)
+LEA_THUNK = bytes.fromhex("8d490c") + b"\xe9" + _rel32(0x00100000 + 8, 0x00100100)
+SUB_THUNK = bytes.fromhex("83e904") + b"\xe9" + _rel32(0x00100000 + 8, 0x00100100)
+STACK_AND_ADD = (bytes.fromhex("8b4c2404") + bytes.fromhex("83c10c")
+                 + b"\xe9" + _rel32(0x001D4CC0 + 12, 0x001D4BEF))
+
+
+class ThisAdjustThunkProbeTest(unittest.TestCase):
+    def test_stack_to_thiscall_is_recognised(self):
+        eng, va = _engine(STACK_THUNK + b"\x90" * 4)
+        self.assertTrue(eng.probes_as_this_adjust_thunk(va))
+
+    def test_imm8_adjustor_is_recognised(self):
+        eng, va = _engine(ADD8_THUNK + b"\x90" * 4, va=0x000EABF6)
+        self.assertTrue(eng.probes_as_this_adjust_thunk(va))
+
+    def test_imm32_adjustor_is_recognised(self):
+        eng, va = _engine(ADD32_THUNK + b"\x90" * 4, va=0x0006FC44)
+        self.assertTrue(eng.probes_as_this_adjust_thunk(va))
+
+    def test_lea_adjustor_is_recognised(self):
+        eng, va = _engine(LEA_THUNK + b"\x90" * 4, va=0x00100000)
+        self.assertTrue(eng.probes_as_this_adjust_thunk(va))
+
+    def test_sub_adjustor_is_recognised(self):
+        eng, va = _engine(SUB_THUNK + b"\x90" * 4, va=0x00100000)
+        self.assertTrue(eng.probes_as_this_adjust_thunk(va))
+
+    def test_stack_load_plus_adjust_is_recognised(self):
+        eng, va = _engine(STACK_AND_ADD + b"\x90" * 4)
+        self.assertTrue(eng.probes_as_this_adjust_thunk(va))
+
+    def test_a_returning_body_is_not_a_thunk(self):
+        # mov ecx, [esp+4]; ret  -- loads an arg, then returns. Not a forwarder.
+        eng, va = _engine(bytes.fromhex("8b4c2404c3") + b"\x90" * 8)
+        self.assertFalse(eng.probes_as_this_adjust_thunk(va))
+
+    def test_a_vcall_thunk_is_not_this_shape(self):
+        # mov eax, [ecx]; jmp [eax+0x10]
+        eng, va = _engine(bytes.fromhex("8b01ff6010") + b"\x90" * 8)
+        self.assertFalse(eng.probes_as_this_adjust_thunk(va))
+
+    def test_indirect_jump_is_not_a_thunk(self):
+        # add ecx, 0xc; jmp eax
+        eng, va = _engine(bytes.fromhex("83c10cffe0") + b"\x90" * 8, va=0x000EABF6)
+        self.assertFalse(eng.probes_as_this_adjust_thunk(va))
+
+    def test_non_executable_section_is_rejected(self):
+        eng, va = _engine(STACK_THUNK + b"\x90" * 4, executable=False)
+        self.assertFalse(eng.probes_as_this_adjust_thunk(va))
+
+
+def _detector(data, va, functions):
+    eng, _ = _engine(data, va=va)
+    for insn in eng._cs.disasm(data, va):
+        eng.instructions[insn.address] = eng._classify_instruction(insn)
+    det = FunctionDetector(eng, eng.image, None, None)
+    for start, end in functions:
+        det.functions[start] = Function(
+            start=start, end=end, name="sub_%08X" % start)
+    return det
+
+
+def _thunk_at(addr, target, prefix=b"\x83\xc1\x0c"):
+    """prefix + jmp rel32, with the displacement computed for `addr`."""
+    jmp_at = addr + len(prefix)
+    return prefix + b"\xe9" + _rel32(jmp_at + 5, target)
+
+
+class ThisAdjustThunkPassTest(unittest.TestCase):
+    def test_immediate_names_a_stack_thunk(self):
+        # Layout, all inside one image:
+        #   0x10000  push thunk; ret          the immediate that names it
+        #   0x10006  ret                      the real method
+        #   0x10020  mov ecx, [esp+4]; jmp 0x10006
+        va = 0x10000
+        method = 0x10006
+        thunk = 0x10020
+        push = b"\x68" + struct.pack("<I", thunk) + b"\xc3"
+        body = _thunk_at(thunk, method, bytes.fromhex("8b4c2404"))
+        data = bytearray(b"\x90" * (thunk - va + len(body) + 4))
+        data[0:len(push)] = push
+        data[method - va] = 0xC3
+        data[thunk - va:thunk - va + len(body)] = body
+        det = _detector(bytes(data), va, [(method, method + 1)])
+        det._pass_imm_ref_targets([det.image.section])
+        self.assertIn(thunk, det._candidates)
+        self.assertEqual(det._candidates[thunk][1], "this_adjust_thunk")
+
+    def test_immediate_whose_jump_leaves_the_image_is_not_a_function(self):
+        # add ecx, 1; jmp well past the image. Shape matches, tail does not.
+        va = 0x10000
+        thunk = va + 16
+        push = b"\x68" + struct.pack("<I", thunk) + b"\xc3"
+        raw = _thunk_at(thunk, thunk + 0x1000, bytes.fromhex("83c101"))
+        data = push + b"\x90" * (thunk - va - len(push)) + raw + b"\x90" * 4
+        det = _detector(data, va, [])
+        det._pass_imm_ref_targets([det.image.section])
+        self.assertNotIn(thunk, det._candidates)
+
+    def test_gap_pass_recovers_a_thunk_packed_after_a_ret(self):
+        va = 0x10000
+        thunk = 0x10010
+        method = 0x10001
+        body = _thunk_at(thunk, method)
+        data = bytearray(b"\x90" * (thunk - va + len(body) + 4))
+        data[0] = 0xC3
+        data[method - va] = 0xC3
+        data[thunk - va:thunk - va + len(body)] = body
+        det = _detector(bytes(data), va, [(va, thunk), (method, method + 1)])
+        self.assertTrue(det._pass_gap_this_adjust_thunks([det.image.section]))
+        self.assertIn(thunk, det._candidates)
+
+    def test_gap_pass_ignores_the_shape_away_from_a_function_end(self):
+        va = 0x10000
+        thunk = 0x10010
+        method = 0x10001
+        body = _thunk_at(thunk, method)
+        # 0x00 is not int3/nop, so the padding walk must not cross it to the thunk.
+        data = bytearray(b"\x00" * (thunk - va + len(body) + 4))
+        data[0] = 0xC3
+        data[method - va] = 0xC3
+        data[thunk - va:thunk - va + len(body)] = body
+        # Function ends at va+1, not at the thunk. No adjacency, no promote.
+        det = _detector(bytes(data), va, [(va, va + 1), (method, method + 1)])
+        self.assertFalse(det._pass_gap_this_adjust_thunks([det.image.section]))
+        self.assertNotIn(thunk, det._candidates)
+
+
+class GapReturningImmTest(unittest.TestCase):
+    def test_jmp_then_ret_in_a_gap_is_a_function(self):
+        # Strict probe stops at the leaving jmp. The ret is still in the gap,
+        # before the next function, and the address was taken.
+        va = 0x10000
+        target = 0x10020
+        push = b"\x68" + struct.pack("<I", target) + b"\xc3"
+        # mov eax, [esp+4]; jmp +0x1000; ret
+        body = bytes.fromhex("8b442404") + b"\xe9" + _rel32(target + 9, target + 0x1000) + b"\xc3"
+        data = bytearray(b"\x90" * (target - va + len(body) + 4))
+        data[0:len(push)] = push
+        data[target - va:target - va + len(body)] = body
+        det = _detector(bytes(data), va, [])
+        self.assertFalse(det.engine.probes_as_returning_body(target))
+        det._pass_imm_ref_targets([det.image.section])
+        self.assertIn(target, det._candidates)
+
+    def test_pop_es_before_the_ret_is_data(self):
+        # Leaving jmp makes the strict probe say no. pop es in the first
+        # dozen instructions is what keeps the gap walk from saying yes.
+        va = 0x10000
+        target = 0x10020
+        push = b"\x68" + struct.pack("<I", target) + b"\xc3"
+        # mov eax, [0x12345678]; pop es; jmp +0x1000; ret
+        body = (bytes.fromhex("a178563412") + b"\x07" + b"\xe9"
+                + _rel32(target + 11, target + 0x1000) + b"\xc3")
+        data = bytearray(b"\x90" * (target - va + len(body) + 4))
+        data[0:len(push)] = push
+        data[target - va:target - va + len(body)] = body
+        det = _detector(bytes(data), va, [])
+        self.assertFalse(det.engine.probes_as_returning_body(target))
+        det._pass_imm_ref_targets([det.image.section])
+        self.assertNotIn(target, det._candidates)
+
+
+if __name__ == "__main__":
+    unittest.main()
