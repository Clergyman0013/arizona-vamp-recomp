 }
 
+/* Resolve an NV2A DMA context handle (e.g. SET_CONTEXT_DMA_SEMAPHORE = 8)
+ * through the PFIFO RAMHT and PRAMIN instance table that D3D8 writes into
+ * the 0xFD000000 aperture during device creation (sub_0034CB42 / sub_003500D0).
+ *
+ *   RAMHT offset = 0x700000 + ((MEM32(0xFD002210) & 0x1F0) << 8)
+ *   hash(h)      = (h ^ (h >> 11) ^ (h >> 22)) & 0x7FF
+ *   entry        = { handle, (channel << 24) | (engine << 16) | inst }
+ *   PRAMIN[inst] = 0xFD700000 + inst * 16:
+ *                    word 1 = limit, word 2 = (phys_base & 0x0FFFFFFF) | flags
+ *
+ * Returns 1 and fills *out_phys_base / *out_limit when found, 0 otherwise. */
+static int nv2a_dma_lookup(const uint8_t *mem, uint32_t handle,
+                           uint32_t *out_phys_base, uint32_t *out_limit)
+{
+    uint32_t ramht_reg, ramht_off, hash, i;
+
+    if (!mem || !handle)
+        return 0;
+    ramht_reg = *(const uint32_t *)(mem + 0xFD002210u);
+    ramht_off = 0x700000u + ((ramht_reg & 0x1F0u) << 8);
+    if (ramht_off < 0x700000u || ramht_off + 0x4000u > 0x800000u)
+        ramht_off = 0x710000u;
+
+    hash = (handle ^ (handle >> 11) ^ (handle >> 22)) & 0x7FFu;
+    for (i = 0; i < 2048u; i++) {
+        uint32_t idx = (i == 0) ? hash : (i - 1u);
+        const uint32_t *ent =
+            (const uint32_t *)(mem + 0xFD000000u + ramht_off + idx * 8u);
+        if (ent[0] == handle && ent[1] != 0) {
