+/* A preemption point, at every direct call.
+ *
+ * Under the guest CPU lock a thread lets go only in kernel calls, so a guest
+ * thread computing without one kept every other guest thread out, however
+ * long it ran -- the console would have preempted it on its quantum, or as
+ * soon as a higher-priority thread became ready. Darkwatch's CRI decode
+ * worker loops on its decoder without suspending while there is work, and
+ * starved the main thread that displays the frames: the chapter movie played
+ * black. A thread that has waited a quantum for the CPU raises
+ * g_recomp_preempt; the holder sees it here, between two guest instructions,
+ * and yields. One load and a branch per call when nobody waits.
+ *
+ * A build that links the lifted code without the kernel (a lifter test)
+ * defines RECOMP_NO_PREEMPT. */
+#ifdef RECOMP_NO_PREEMPT
+#define RECOMP_PREEMPT_POINT() ((void)0)
+#else
+extern volatile int g_recomp_preempt;
+void recomp_preempt(void);
+#define RECOMP_PREEMPT_POINT() do { if (g_recomp_preempt) recomp_preempt(); } while (0)
+#endif
