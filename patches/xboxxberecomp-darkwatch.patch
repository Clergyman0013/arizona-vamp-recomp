+ID3D12PipelineState* D3D12Backend::EnsureMsPipeline(const char* hlsl, bool depth, DXGI_FORMAT rtv, uint32_t samples) {
+    uint64_t key = Hash(hlsl, std::strlen(hlsl), uint64_t(rtv) << 8 | samples) | 1;
+    auto& pso = blit_psos_[key];
+    if (pso) return pso.Get();
+    uint64_t h;
+    ID3DBlob* vs = Compile(hlsl, "vs", "vs_5_0", h);
+    ID3DBlob* ps = Compile(hlsl, "psmain", "ps_5_0", h);
+    if (!vs || !ps) return nullptr;
