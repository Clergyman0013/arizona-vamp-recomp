+    return 0;
+}
+
+std::vector<int> g_keys[kControls];  // virtual keys per control, from the settings
+bool g_keys_read = false;
+
+void ReadBindings() {
+    if (g_keys_read) return;
+    g_keys_read = true;
+    for (int c = 0; c < kControls; c++) {
+        std::string names = kControlNames[c].keys;
+        for (const auto& [control, keys] : app::Get().keys)
+            if (control == kControlNames[c].name) names = keys;
+        size_t at = 0;
+        while (at <= names.size()) {
+            size_t end = names.find(',', at);
+            std::string one = names.substr(at, end == std::string::npos ? std::string::npos : end - at);
+            one.erase(0, one.find_first_not_of(' '));
+            one.erase(one.find_last_not_of(' ') + 1);
+            if (int vk = VirtualKey(one)) g_keys[c].push_back(vk);
+            else if (!one.empty()) LOGW("input: unknown key \"%s\" for %s", one.c_str(), kControlNames[c].name);
+            if (end == std::string::npos) break;
+            at = end + 1;
+        }
+    }
+}
+
+bool Held(int control) {
+    for (int vk : g_keys[control])
+        if (GetAsyncKeyState(vk) & 0x8000) return true;
+    return false;
+}
+
+// the mouse: raw motion summed by the window thread, read as the right stick at the speed it moved
+std::atomic<int> g_mouse_dx{0}, g_mouse_dy{0};
+std::atomic<bool> g_mouse_on{true};  // F2 toggles
+bool g_clipped = false;
+uint64_t g_mouse_t = 0;  // when the motion was last read, ms
+float g_look_x = 0, g_look_y = 0;
+
+uint64_t NowMs() { return GetTickCount64(); }
+
+bool Focused() { return app::Window() && GetForegroundWindow() == static_cast<HWND>(app::Window()); }
+
+// the cursor kept in a small box at the window's centre while the mouse looks, let go otherwise
+void Clip(bool on) {
+    if (on) {
+        RECT r;
+        if (!GetClientRect(static_cast<HWND>(app::Window()), &r)) return;
+        POINT c{(r.left + r.right) / 2, (r.top + r.bottom) / 2};
+        ClientToScreen(static_cast<HWND>(app::Window()), &c);
+        RECT box{c.x - 1, c.y - 1, c.x + 1, c.y + 1};
+        ClipCursor(&box);
+        g_clipped = true;
+    } else if (g_clipped) {
+        ClipCursor(nullptr);
+        g_clipped = false;
+    }
+}
+
+// a stick reading from mouse speed: past the game's dead zone at once, full at kFullSpeed pixels a second
+constexpr float kFullSpeed = 1200.0f;
+constexpr float kDeadZone = 0.22f;
+float Look(float pixels_per_second) {
+    float v = pixels_per_second * float(app::Get().mouse_sensitivity) / 100.0f / kFullSpeed;
+    if (std::fabs(v) < 1e-4f) return 0;
+    float m = std::min(std::fabs(v), 1.0f);
+    return std::copysign(kDeadZone + (1.0f - kDeadZone) * m, v);
+}
+
+int16_t Axis(float v) { return int16_t(std::clamp(v, -1.0f, 1.0f) * 32767.0f); }
+
+void AddKeyboardMouse(Pad& p) {
+    const app::Settings& s = app::Get();
+    if (!s.keyboard) return;
+    p.connected = true;  // a controller is plugged in for the game, even with none on the PC
+    bool focus = Focused();
+    bool look = focus && s.mouse_look && g_mouse_on;
+    Clip(look);
+    if (!focus) {
+        g_mouse_dx = 0;
+        g_mouse_dy = 0;
+        return;
+    }
+    ReadBindings();
+    for (int c = kA; c <= kRT; c++)
+        if (Held(c)) p.analog[c - kA] = 0xFF;
+    for (int c = kUp; c <= kRS; c++)
+        if (Held(c)) p.buttons |= uint16_t(1u << (c - kUp));
+    auto stick = [&](int neg, int pos) { return float(Held(pos)) - float(Held(neg)); };
+    float lx = stick(kLeftStickLeft, kLeftStickRight), ly = stick(kLeftStickDown, kLeftStickUp);
+    if (lx || ly) {
+        float n = std::sqrt(lx * lx + ly * ly);  // a diagonal is no faster than straight on
+        p.lx = Axis(lx / n);
+        p.ly = Axis(ly / n);
+    }
+    float rx = stick(kRightStickLeft, kRightStickRight), ry = stick(kRightStickDown, kRightStickUp);
+    // the mouse: read every 10 ms, held between
+    uint64_t now = NowMs();
+    if (now - g_mouse_t >= 10) {
+        float dt = g_mouse_t ? float(now - g_mouse_t) / 1000.0f : 0.01f;
+        g_mouse_t = now;
+        int dx = g_mouse_dx.exchange(0), dy = g_mouse_dy.exchange(0);
+        g_look_x = look ? Look(float(dx) / dt) : 0;
+        g_look_y = look ? Look(float(-dy) / dt) : 0;  // the mouse moved up looks up
+    }
+    if (!rx) rx = g_look_x;
+    if (!ry) ry = g_look_y;
+    if (rx) p.rx = Axis(rx);
+    if (ry) p.ry = Axis(ry);
+}
