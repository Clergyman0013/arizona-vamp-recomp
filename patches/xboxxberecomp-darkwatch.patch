+        p.NumRenderTargets = 0;
+        p.RTVFormats[0] = DXGI_FORMAT_UNKNOWN;
+        p.DepthStencilState.DepthEnable = TRUE;
+        p.DepthStencilState.DepthWriteMask = D3D12_DEPTH_WRITE_MASK_ALL;
+        p.DepthStencilState.DepthFunc = D3D12_COMPARISON_FUNC_ALWAYS;
+        p.DSVFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    }
+    p.SampleDesc.Count = samples;
+    if (FAILED(dev_->CreateGraphicsPipelineState(&p, IID_PPV_ARGS(&pso)))) {
+        LOG_FIRST(4, "d3d12: multisample pass pipeline failed");
+        return nullptr;
+    }
+    return pso.Get();
