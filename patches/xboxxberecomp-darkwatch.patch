+std::vector<std::pair<std::string, std::string>> Bindings() {
+    std::vector<std::pair<std::string, std::string>> out;
+    for (const ControlName& c : kControlNames) {
+        std::string keys = c.keys;
+        for (const auto& [control, names] : app::Get().keys)
