+    {"a", "Space,Enter"}, {"b", "E,Backspace"}, {"x", "R"}, {"y", "Q"}, {"black", "C"}, {"white", "F"},
+    {"left_trigger", "Mouse2"}, {"right_trigger", "Mouse1"},
+    {"dpad_up", "Up"}, {"dpad_down", "Down"}, {"dpad_left", "Left"}, {"dpad_right", "Right"},
+    {"start", "Escape"}, {"back", "Tab"}, {"left_thumb", "LShift"}, {"right_thumb", "Mouse3,V"},
