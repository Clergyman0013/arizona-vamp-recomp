+// the shader blob disk cache beside the exe ("shadercache v1" in Compile's seed, so a
+// format change drops old files): <exe dir>\shadercache\<hash as 16 hex>.dxbc
+constexpr char kShaderCacheDir[] = "shadercache";
+constexpr char kShaderCacheVersion[] = "shadercache v1";
+constexpr size_t kShaderCacheMaxBytes = 64ull << 20;
+
+std::string ShaderCacheName(uint64_t hash) {
+    char name[24];
+    std::snprintf(name, sizeof(name), "%016llx.dxbc", (unsigned long long)hash);
+    return name;
+}
+
+// a DXBC container: 'DXBC', 16 bytes of digest, version, u32 total size, chunk count.
+// A truncated file still has its size field, so this catches the hand-corrupted case.
+bool ValidDxbc(const std::vector<char>& bytes) {
+    if (bytes.size() < 32) return false;
+    uint32_t magic = 0, size = 0;
+    std::memcpy(&magic, bytes.data(), 4);
+    std::memcpy(&size, bytes.data() + 24, 4);
+    return magic == 0x43425844u /* 'DXBC' */ && size == bytes.size();
+}
+
+bool LoadShaderCache(const std::filesystem::path& file, ComPtr<ID3DBlob>* out) {
+    std::error_code ec;
+    uint64_t size = std::filesystem::file_size(file, ec);
+    if (ec || size == 0 || size > kShaderCacheMaxBytes) return false;
+    std::ifstream in(file, std::ios::binary);
+    if (!in) return false;
+    std::vector<char> bytes((size_t)size);
+    in.read(bytes.data(), (std::streamsize)size);
+    if (!in || !ValidDxbc(bytes)) return false;
+    ComPtr<ID3DBlob> blob;
+    if (FAILED(D3DCreateBlob((SIZE_T)size, &blob))) return false;
+    std::memcpy(blob->GetBufferPointer(), bytes.data(), (size_t)size);
+    *out = blob;
+    return true;
+}
+
+// written beside the file (named for this process, as a second instance may write too), then moved over it
+void WriteWhole(const std::filesystem::path& file, const void* data, size_t size) {
+    std::error_code ec;
+    std::filesystem::create_directories(file.parent_path(), ec);
+    if (ec) return;
+    std::filesystem::path tmp = file;
+    tmp += "." + std::to_string(GetCurrentProcessId()) + ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+        if (!out) return;
+        out.write(static_cast<const char*>(data), (std::streamsize)size);
+        out.close();
+        // rename only a complete write, so a crash never leaves half a file
+        if (!out) return;
+    }
+    std::filesystem::rename(tmp, file, ec);
+    if (ec) std::filesystem::remove(tmp, ec);
+}
+
+void StoreShaderCache(const std::filesystem::path& file, ID3DBlob* code) {
+    WriteWhole(file, code->GetBufferPointer(), code->GetBufferSize());
+}
+
+// pipelines kept between runs (D3D12Backend::OpenPipelineCache): the list of every pipeline key a draw needed, for
+// any driver, then a header-checked PsoKey after another; and this driver's compiled pipelines, a pipeline library
+// named for the GPU and driver version, so a new driver finds none and compiles the list again
+constexpr char kPipelineList[] = "pipelines.bin";
+constexpr uint32_t kPipelineListMagic = 0x314F5350;  // 'PSO1'
+constexpr double kPipelineSaveSeconds = 30;          // the library is written at most this often while it grows
+struct PipelineListHeader {
+    uint32_t magic;
+    uint32_t key_size;  // sizeof(PsoKey): a changed key drops the list
+    uint64_t version;   // kShaderCacheVersion's hash, as the shader file names are seeded with it
+};
+
+PipelineListHeader ListHeader() {
+    return {kPipelineListMagic, uint32_t(sizeof(PsoKey)), Hash(kShaderCacheVersion, std::strlen(kShaderCacheVersion))};
+}
+
+bool ReadWhole(const std::filesystem::path& file, std::vector<char>& out) {
+    std::ifstream in(file, std::ios::binary);
+    if (!in) return false;
+    out.assign(std::istreambuf_iterator<char>(in), {});
+    return true;
+}
