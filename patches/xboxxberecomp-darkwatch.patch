+// a key name as the settings file has it: a letter or digit, F1-F12, Num0-Num9, or a name below
+int VirtualKey(std::string n) {
+    for (char& c : n) c = char(std::tolower(static_cast<unsigned char>(c)));
+    if (n.size() == 1 && std::isalnum(static_cast<unsigned char>(n[0]))) return std::toupper(static_cast<unsigned char>(n[0]));
+    if (n.size() >= 2 && n[0] == 'f' && std::isdigit(static_cast<unsigned char>(n[1]))) {
+        int f = std::atoi(n.c_str() + 1);
+        if (f >= 1 && f <= 12) return VK_F1 + f - 1;
+    }
+    if (n.size() == 4 && n.rfind("num", 0) == 0 && std::isdigit(static_cast<unsigned char>(n[3]))) return VK_NUMPAD0 + n[3] - '0';
+    static const std::pair<const char*, int> kNames[] = {
+        {"space", VK_SPACE},     {"enter", VK_RETURN},  {"escape", VK_ESCAPE},  {"esc", VK_ESCAPE},
+        {"tab", VK_TAB},         {"backspace", VK_BACK}, {"shift", VK_SHIFT},   {"lshift", VK_LSHIFT},
+        {"rshift", VK_RSHIFT},   {"ctrl", VK_CONTROL},  {"lctrl", VK_LCONTROL}, {"rctrl", VK_RCONTROL},
+        {"alt", VK_MENU},        {"lalt", VK_LMENU},    {"ralt", VK_RMENU},     {"up", VK_UP},
+        {"down", VK_DOWN},       {"left", VK_LEFT},     {"right", VK_RIGHT},    {"insert", VK_INSERT},
+        {"delete", VK_DELETE},   {"home", VK_HOME},     {"end", VK_END},        {"pageup", VK_PRIOR},
+        {"pagedown", VK_NEXT},   {"mouse1", VK_LBUTTON}, {"mouse2", VK_RBUTTON}, {"mouse3", VK_MBUTTON},
+        {"mouse4", VK_XBUTTON1}, {"mouse5", VK_XBUTTON2}, {"comma", VK_OEM_COMMA}, {"period", VK_OEM_PERIOD},
+    };
+    for (const auto& [name, vk] : kNames)
